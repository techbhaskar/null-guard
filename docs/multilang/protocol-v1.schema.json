{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NullGuard language pack response 1.0",
  "type": "object",
  "required": [
    "protocolVersion",
    "analyzerVersion",
    "project",
    "languages",
    "status",
    "findings",
    "coverage",
    "diagnostics",
    "capabilities"
  ],
  "properties": {
    "protocolVersion": {
      "const": "1.0"
    },
    "analyzerVersion": {
      "const": "2.0.0-preview.1"
    },
    "project": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "java",
          "python",
          "javascript",
          "typescript",
          "csharp",
          "go",
          "rust"
        ]
      }
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ruleId",
          "language",
          "severity",
          "confidence",
          "message",
          "evidence",
          "location"
        ],
        "properties": {
          "ruleId": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "warning",
              "error",
              "note"
            ]
          },
          "confidence": {
            "enum": [
              "experimental",
              "medium",
              "high"
            ]
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "location": {
            "type": "object",
            "required": [
              "path",
              "startLine",
              "startColumn"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "startLine": {
                "type": "integer",
                "minimum": 1
              },
              "startColumn": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "relatedLocations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "startLine",
                "startColumn"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "startLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "startColumn": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "discoveredFiles",
          "analyzedFiles",
          "failedFiles",
          "unsupportedFiles",
          "unresolvedSymbols",
          "budgetExhausted",
          "missingDependencies"
        ],
        "properties": {
          "discoveredFiles": {
            "type": "integer",
            "minimum": 0
          },
          "analyzedFiles": {
            "type": "integer",
            "minimum": 0
          },
          "failedFiles": {
            "type": "integer",
            "minimum": 0
          },
          "unsupportedFiles": {
            "type": "integer",
            "minimum": 0
          },
          "unresolvedSymbols": {
            "type": "integer",
            "minimum": 0
          },
          "budgetExhausted": {
            "type": "boolean"
          },
          "missingDependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "object"
    }
  }
}
