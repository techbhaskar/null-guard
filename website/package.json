{
  "name": "nullguard-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "start": "npm run sync-docs && docusaurus start --host 127.0.0.1",
    "build": "npm run sync-docs && docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mermaid-js/layout-elk": "0.1.9",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
