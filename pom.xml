<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nullguard</groupId>
    <artifactId>nullguard-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>nullguard-core</module>
        <module>nullguard-analysis</module>
        <module>nullguard-callgraph</module>
        <module>nullguard-scoring</module>
        <module>nullguard-suggestions</module>
        <module>nullguard-visualization</module>
        <module>nullguard-cli</module>
        <module>nullguard-maven-plugin</module>
        <module>nullguard-coverage</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javaparser.version>3.25.8</javaparser.version>
        <!--
            Surefire MUST be pinned. The version inherited from the default lifecycle
            bindings on Maven 3.8.x is 2.12.4, which only knows the JUnit 3/4 providers
            and therefore silently executes ZERO JUnit 5 tests ("Tests run: 0").
            Every module in this build tests with junit-jupiter, so without this pin
            the whole suite is a no-op that always passes.
        -->
        <surefire.version>3.2.5</surefire.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.12</version>
                <executions>
                    <execution><id>coverage-agent</id><goals><goal>prepare-agent</goal></goals></execution>
                    <execution><id>coverage-report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-symbol-solver-core</artifactId>
                <version>${javaparser.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
